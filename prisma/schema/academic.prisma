model AcademicYear {
  id        String   @id @default(uuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  classes       Class[]
  enrollments   StudentEnrollment[]
  exams         Exam[]
  holidays      Holiday[]
  terms         Term[]
  homework      Homework[]
  feeStructures FeeStructure[]
  feeRecords    FeeRecord[]

  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  academicYearId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  exams        Exam[]

  @@unique([name, academicYearId])
  @@index([academicYearId])
  @@map("terms")
}

model Class {
  id             String   @id @default(uuid())
  name           String
  gradeLevel     Int
  academicYearId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  academicYear       AcademicYear             @relation(fields: [academicYearId], references: [id])
  attendances        Attendance[]
  enrollments        StudentEnrollment[]
  exams              Exam[]
  teacherAssignments TeacherClassAssignment[]
  homework           Homework[]

  @@unique([name, academicYearId])
  @@index([academicYearId])
  @@index([gradeLevel, academicYearId])
  @@map("classes")
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String
  gradeLevel  Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  examSubjects       ExamSubject[]
  teacherAssignments TeacherClassAssignment[]
  homework           Homework[]

  @@unique([name, gradeLevel])
  @@unique([code, gradeLevel])
  @@index([gradeLevel])
  @@map("subjects")
}

model Holiday {
  id             String   @id @default(uuid())
  name           String
  date           DateTime @db.Date
  academicYearId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([date, academicYearId])
  @@index([academicYearId])
  @@map("holidays")
}