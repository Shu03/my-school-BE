enum FeeRecordStatus {
  PENDING
  PARTIAL
  PAID
}

model FeeStructure {
  id             String   @id @default(uuid())
  classLevel     Int
  academicYearId String
  totalAmount    Float
  dueDate        DateTime @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  feeRecords   FeeRecord[]

  @@unique([classLevel, academicYearId])
  @@index([academicYearId])
  @@map("fee_structures")
}

model FeeRecord {
  id             String          @id @default(uuid())
  studentId      String
  academicYearId String
  feeStructureId String
  totalAmount    Float
  status         FeeRecordStatus @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])
  feeStructure FeeStructure   @relation(fields: [feeStructureId], references: [id])
  payments     FeePayment[]

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
  @@index([studentId])
  @@map("fee_records")
}

model FeePayment {
  id           String   @id @default(uuid())
  feeRecordId  String
  amount       Float
  paidOn       DateTime @db.Date
  note         String?
  recordedById String?
  createdAt    DateTime @default(now())

  feeRecord  FeeRecord @relation(fields: [feeRecordId], references: [id], onDelete: Cascade)
  recordedBy User?     @relation("FeePaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([feeRecordId])
  @@map("fee_payments")
}
